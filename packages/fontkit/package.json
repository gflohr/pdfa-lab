{
	"name": "@pdfa-lab/fontkit",
	"version": "1.1.0",
	"description": "An advanced font engine for Node and the browser",
	"type": "module",
	"main": "dist/fontkit.umd.js",
	"unpkg": "dist/fontkit.umd.min.js",
	"module": "dist/fontkit.esm.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/fontkit.esm.js",
			"require": "./dist/fontkit.cjs",
			"default": "./dist/fontkit.umd.js"
		}
	},
	"scripts": {
		"clean": "rimraf --glob dist node_modules/.cache \"src/**/trie.ts\" \"src/**/trie-indic.ts\" \"src/**/trie-use.ts\" \"src/**/indic.ts\" \"src/**/use.ts\"",
		"generate:data": "pnpm exec tsx scripts/gen-trie.ts && pnpm exec tsx scripts/gen-use.ts && pnpm exec tsx scripts/gen-indic.ts",
		"build:tsc": "tsc",
		"build:rollup": "pnpm run clean && pnpm run generate:data && rollup -c",
		"build": "pnpm run build:rollup",
		"dev": "rollup -c -w",
		"check": "biome check",
		"check:fix": "biome check --write",
		"prepublishOnly": "pnpm run build",
		"test": "vitest --run",
		"test:changed": "vitest --changed origin/main --passWithNoTests",
		"test:watch": "vitest",
		"test:cov": "vitest --coverage.enabled --run",
		"test:cov-changed": "vitest --coverage.enabled --run --changed origin/main --passWithNoTests",
		"typedoc": "typedoc"
	},
	"dependencies": {
		"brotli": "^1.3.3",
		"deep-equal": "^2.2.3",
		"pako": "^3.0.1",
		"restructure": "^3.0.2",
		"unicode-properties": "^1.4.1"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-inject": "^5.0.5",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-swc": "^0.4.1",
		"@rollup/plugin-terser": "^1.0.0",
		"@types/brotli": "^1.3.5",
		"@types/deep-equal": "^1.0.4",
		"@types/node": "^26.0.0",
		"@types/pako": "^2.0.4",
		"base64-arraybuffer": "^1.0.2",
		"codepoints": "^1.3.0",
		"dfa": "^1.2.0",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.2",
		"rollup-plugin-polyfill-node": "^0.13.0",
		"rollup-plugin-typescript2": "^0.37.0",
		"tiny-inflate": "^1.0.3",
		"tsx": "^4.22.4",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.3",
		"typescript": "^6.0.3",
		"unicode-trie": "^2.0.0",
		"vitest": "^4.1.9"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/gflohr/pdfa-lab.git"
	},
	"keywords": [
		"opentype",
		"font",
		"typography",
		"subset",
		"emoji",
		"glyph",
		"layout"
	],
	"author": "Guido Flohr <guido.flohr@cantanea.com>",
	"contributors": [
		"Devon Govett <devongovett@gmail.com> (http://badassjs.com/)",
		"Andrew Dillon <andrew.dillon.j@gmail.com>"
	],
	"bugs": {
		"url": "https://github.com/gflohr/pdfa-lab/issues"
	},
	"license": "MIT",
	"homepage": "https://github.com/gflohr/pdfa-lab/packages/fontkit#readme"
}
