{
	"name": "@pdfa-lab/core",
	"version": "0.1.0",
	"private": true,
	"description": "Convert PDFs to PDF/A-1b, PDF/A-2b, or PDF/A-3b, embed fonts, extract text, extract and modify XMP meta information, for Node and the browser.",
	"homepage": "https://github.com/gflohr/pdfa-lab/tree/main/packages/core#readme",
	"keywords": [
		"PDF",
		"PDF/A",
		"PDF/A-1b",
		"PDF/A-2b",
		"PDF/A-3b",
		"Factur-X",
		"ZUGFeRD",
		"XMP",
		"nodejs",
		"typescript"
	],
	"license": "WTFPL",
	"type": "module",
	"main": "./dist/index.cjs.cjs",
	"module": "./dist/index.esm.js",
	"browser": "./dist/index.browser.js",
	"typings": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.esm.js",
			"require": "./dist/index.cjs.cjs",
			"browser": "./dist/index.browser.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "rimraf dist && rollup -c",
		"check": "biome check",
		"check:fix": "biome check --write",
		"dev": "rollup -c -w",
		"test": "vitest --run",
		"test:changed": "vitest --changedSince origin/main --passWithNoTests",
		"test:watch": "vitest",
		"test:cov": "vitest --coverage.enabled --run",
		"test:cov-changed": "vitest --coverage.enabled --run --changed origin/main --passWithNoTests",
		"typedoc": "typedoc"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "^4.1.9",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.2",
		"rollup-plugin-polyfill-node": "^0.13.0",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@cantoo/pdf-lib": "^2.7.1",
		"@pdfa-lab/fontkit": "workspace:*",
		"@xmldom/xmldom": "^0.9.11",
		"rdflib": "^2.4.0",
		"valibot": "^1.4.1",
		"xml-formatter": "^3.7.0"
	}
}
